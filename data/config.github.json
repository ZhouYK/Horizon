{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": false
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": false
      }
    ],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": false,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": false,
          "sort": "new",
          "fetch_limit": 10
        }
      ],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "users": ["karpathy", "ylecun"],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "megacaps",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "finance-cn",
          "symbols": ["AAPL", "MSFT", "NVDA", "GOOGL", "AMZN", "META", "TSLA", "比亚迪", "BYD"]
        }
      ]
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript"],
      "keywords": [],
      "min_stars": 10,
      "max_items": 30
    },
    "gdelt": [
      {
        "enabled": true,
        "query": "artificial intelligence",
        "mode": "ArtList",
        "max_records": 75,
        "timespan": null,
        "language": null,
        "country": null,
        "category": "ai-news"
      },
      {
        "enabled": false,
        "stocks": ["比亚迪", "迈瑞医疗", "中国中免", "002594", "300760", "601888"],
        "mode": "ArtList",
        "max_records": 75,
        "timespan": null,
        "language": null,
        "country": null,
        "category": "finance-cn"
      }
    ],
    "google_news": [
      {
        "enabled": true,
        "query": "artificial intelligence",
        "language": "en",
        "country": "US",
        "ceid": null,
        "max_results": 100,
        "category": "ai-news"
      },
      {
        "enabled": false,
        "stocks": ["比亚迪", "迈瑞医疗", "中国中免", "002594", "300760", "601888"],
        "language": "zh-CN",
        "country": "CN",
        "ceid": null,
        "max_results": 100,
        "category": "finance-cn"
      }
    ],
    "aibase": {
      "enabled": true,
      "max_items": 20,
      "language": "en",
      "category": "ai-news"
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20
        }
      ]
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24,
    "max_items": null,
    "category_groups": {
      "ai": {
        "name": "AI 资讯",
        "limit": 10,
        "categories": ["ai-news", "ai-tools", "news"],
        "report": "ai"
      },
      "stocks": {
        "name": "股票资讯",
        "limit": 20,
        "categories": ["finance-cn", "finance", "stocks", "investing"],
        "report": "stock",
        "preset_domains": ["finance"],
        "stocks": ["比亚迪", "迈瑞医疗", "中国中免", "002594", "300760", "601888"],
        "stock_limit": 5
      }
    },
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "slack",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh",
      "en"
    ],
    "request_body": {
      "text": "#{message_title}\n\n#{summary?limit=3000&split=---}"
    },
    "headers": ""
  }
}
